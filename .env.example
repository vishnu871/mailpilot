# ============================================================
# MailPilot Configuration
# ============================================================

# ------------------------------------------------------------
# Application mode
# ------------------------------------------------------------
# dry_run = analyze emails without changing the mailbox
# test    = controlled mailbox testing
# live    = allow folder creation and email movement
MAILPILOT_RUN_MODE=dry_run

# Maximum number of Inbox messages processed in one cycle
MAILPILOT_INBOX_BATCH_SIZE=50

# Logging level
MAILPILOT_LOG_LEVEL=INFO


# ------------------------------------------------------------
# Microsoft Authentication
# ------------------------------------------------------------

# Microsoft Entra application (client) ID.
# Replace this placeholder with the client ID from your
# Microsoft app registration.
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID

# Microsoft identity authority.
# "common" supports organizational and personal accounts.
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# Microsoft Graph delegated permissions.
# Mail.ReadWrite is required for reading mail, creating folders,
# and moving messages.
# MailPilot does not request Mail.Send because it does not send mail.
MICROSOFT_SCOPES=Mail.ReadWrite